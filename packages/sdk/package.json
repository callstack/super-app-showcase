{
  "name": "super-app-showcase-sdk",
  "version": "0.0.2",
  "description": "Dependency management & utils for the Super App Showcase",
  "license": "MIT",
  "homepage": "https://github.com/callstack/super-app-showcase",
  "repository": "github:callstack/super-app-showcase",
  "main": "index.js",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
